# zram doc: https://docs.kernel.org/admin-guide/blockdev/zram.html

# shellcheck shell=sh

# shellcheck disable=SC2034
description="Manages zram devices"

zram_label="${RC_SVCNAME#*.}"

: "${zram_type:=swap}"

: "${zram_storage_mountpoint:=""}"
: "${zram_storage_mode:=755}"
: "${zram_storage_options:=noatime}"
: "${zram_storage_owgr:=""}"
: "${zram_storage_discard:=""}"

: "${zram_swap_priority:=32767}"
: "${zram_swap_discard:=both}"

: "${zram_size:=25%}"
: "${zram_writeback:=incompressible}"
: "${zram_writeback_limit:=""}"
: "${zram_mem_limit:=""}"
: "${zram_backing_dev:=""}"
: "${zram_comp_algo:=""}"
: "${zram_algo_params:=""}"
: "${zram_idle:=""}"

depend() {
  need localmount
  after swap zram.*
}

_timeout() {
  _t="$(($1 * 10))" _i=0 
  shift
  while [ "$_i" -lt "$_t" ]; do
    command "$@" 2> /dev/null && return 0
    _i="$((_i + 1))"
    sleep 0.1
  done
  return 1
}

_checklocks() {
  set -- /var/lock/zram.*.lock
  [ -e "$1" ] && return 1
  return 0
}

_mklock() {
  ! [ -e  "/var/lock/zram.${zram_label}.lock" ] || return 1
  touch "/var/lock/zram.${zram_label}.lock"
}

_rmlock() {
  [ -e "/var/lock/zram.${zram_label}.lock" ] \
    && rm "/var/lock/zram.${zram_label}.lock" > /dev/null 2>&1
}

_getswap() {
  _label="$1"
  _return=""
  while read -r _swap_dev; do
    if [ "$_label" = "${_swap_dev% *}" ]; then
      _return="$_swap_dev"
      break
    fi
  done << EOF 
  $(swapon --show=label,name --raw --noheadings)
EOF
  echo "$_return"
}

_checkswap() {
  _label="$1"
  for _swap_dev in $(swapon --show=label --raw --noheadings); do
    [ "$_label" = "$_swap_dev" ] && return 1
  done
  return 0
}

_mkswap() {
  _zram="$1"
  _op=""
  _pri="$zram_swap_priority"
  case "$zram_swap_discard" in
    both)
      _op="--discard"
      ;;
    once|pages)
      _op="--discard=${zram_swap_discard}"
      ;;
    *)
      ewarn "Invalid value for discard, using default"
      _op="--discard"
      ;;
  esac
  if [ "$zram_swap_priority" -gt 32767 ]; then
    ewarn "Invalid swap priority, using default."
    _pri=32767
  fi
  mkswap --uuid random --label "$zram_label" "${_zram}" > /dev/null 2>&1 \
    && swapon "$_op" --priority "$_pri" "${_zram}" > /dev/null 2>&1 \
    && einfo "Successfully created zram swap: ${zram_label}"
}

_rmswap() {
  _zram="$1"
  swapoff -L "$zram_label" > /dev/null 2>&1 \
    && _timeout 5 echo 1 > "/sys/block/${_zram##*/}/reset" \
    && _timeout 5 echo "${_zram##*zram}" > /sys/class/zram-control/hot_remove \
    && einfo "Removed zram swap: ${zram_label}"
}

_mkstorage() {
  _zram="$1"
  _fsop="huge_file,sparse_super,extent,^uninit_bg,dir_nlink,extra_isize,^has_journal"
  _mop="defaults"
  if [ -n "${zram_storage_options}" ]; then
    _mop="${_mop},${zram_storage_options}"
  fi
  if [ -n "$zram_storage_discard" ] && [ "$zram_storage_discard" = "y" ]; then
    _mop="${_mop},discard"
  fi
  if mkfs.ext4 -m0 -O"${_fsop}" -U random -L "$zram_label" -- "${_zram}" > /dev/null 2>&1 && tune2fs -c0 -i0 -m0 -- "${_zram}" > /dev/null 2>&1; then
    if [ -n "${zram_storage_mountpoint}" ] && mount --mkdir -t ext4 -o "$_mop" -- "${_zram}" "${zram_storage_mountpoint}" > /dev/null 2>&1; then
      [ -n "$zram_storage_mode" ] \
        && { chmod --quiet "${zram_storage_mode}" "${zram_storage_mountpoint}" \
        || ewarn "Invalid value for mode"; }
      [ -n "$zram_storage_owgr" ] \
        && { chown --quiet "${zram_storage_owgr}" "${zram_storage_mountpoint}" \
        || ewarn "Invalid value for owner"; }
      einfo "Successfully created zram: ${zram_label}"
    else
      ewarn "Zram ${zram_label} created but not mounted: invalid mountpoint"   
    fi
  fi
}

_rmstorage() {
  _zram="$1"
  [ -n "${zram_storage_mountpoint}" ] \
  && umount "${_zram}" > /dev/null 2>&1 \
  && _timeout 5 echo 1 > "/sys/block/${_zram##*/}/reset" \
  && _timeout 5 echo "${_zram##*zram}" > /sys/class/zram-control/hot_remove \
  && einfo "Removed zram storage: ${zram_label}"
}

_exit() {
  _retval="$1"
  shift
  [ "$_retval" -ne 0 ] && _rmlock
  eend "$_retval" "$@"
  exit "$_retval"
}

start_pre() {
  if [ "$zram_label" = "$RC_SVCNAME" ]; then
    eerror "${RC_SVCNAME} cannot be started directly. You must create" 
    eerror "symbolic links to it for the zram devices you want to start"
    return 1
  fi
  if [ "$RC_CMD" = "start" ] && [ -e "/var/lock/zram.${zram_label}.lock" ]; then
    eerror "Zram device with label ${zram_label} already exists"
    return 1
  fi
  if ! [ -d "/sys/module/zram" ]; then
    ebegin "Starting zram"
    ! modprobe --dry-run zram > /dev/null 2>&1 \
    || { modprobe zram > /dev/null 2>&1 \
        && einfo "Zram module loaded"; }
  fi
  eend $? "Could not find or load zram module"
}

start() {
  _zram=""
  _mem_to_alloc=""
  _hot=0
  _refcnt=0
  _mem_total=0
  _state=0

  for _zram_dev in /sys/block/zram*; do
    _timeout 5 read -r _state < "${_zram_dev}/initstate"
    if [ "$_state" -eq 0 ]; then
      _zram="${_zram_dev##*/}"
      break
    fi
  done
  if [ -z "$_zram" ]; then
    if _timeout 5 read -r _hot < /sys/class/zram-control/hot_add; then
        _zram="zram${_hot}"
    else
      eend 1 "Failed to hot add a zram device"
    fi
  fi

  _mklock \
    || eend 1 "A lock file exists"
  
  while read -r _mem_header _mem_size _; do [ "$_mem_header" != "MemTotal:" ] || break; done < /proc/meminfo
  _mem_total="$((_mem_size / 1024))"

  case "${zram_size##*[0-9]}" in
    %)
      _mem_to_alloc="$((${zram_size%\%} * _mem_total / 100))MiB"
      ;;
    [KkMmGgTtPpEeZzYy]|[KkMmGgTtPpEeZzYy][Ii][Bb])
      _mem_to_alloc="$zram_size"
      ;;
    *)
      ewarn "Invalid value for size, using default"
      _mem_to_alloc="$((25 * _mem_total / 100))MiB"
      ;;
  esac

  einfo "Initializing zram device: /dev/${_zram}"
  
  _timeout 5 echo 1 > "/sys/block/${_zram}/reset" \
    || _exit 1 "Failed to reset zram device /dev/${_zram}: device or resource busy"

  if [ -n "$zram_backing_dev" ]; then
    if echo "$zram_backing_dev" > "/sys/block/${_zram}/backing_dev" 2> /dev/null; then
      if [ -z "$zram_comp_algo" ] || ! echo "$zram_comp_algo" > "/sys/block/${_zram}/comp_algorithm" 2> /dev/null; then
        ewarn "Invalid compression algorithm chosen, using default. This kernel may not support this algorithm."
      fi
      echo "$_mem_to_alloc" > "/sys/block/${_zram}/disksize" 2> /dev/null
      if [ -z "$zram_writeback" ] || echo "$zram_writeback" > "/sys/block/${_zram}/writeback" 2> /dev/null; then
          if [ -z "$zram_writeback_limit" ] || ! echo "$((${zram_writeback_limit%%[A-Za-z]*}<<20>>12))" > "/sys/block/${_zram}/writeback_limit" 2> /dev/null \
            || ! echo 1 > "/sys/block/${_zram}/writeback_limit_enable" 2> /dev/null; then
            ewarn "Failed to write /dev/${_zram} writeback limit"
          fi
      else 
        ewarn "Failed to set /dev/${_zram} writeback"
      fi
    else
      ewarn "Failed to write /dev/${_zram} backing device"
    fi
  else
    [ -n "$zram_comp_algo" ] \
      && { echo "$zram_comp_algo" > "/sys/block/${_zram}/comp_algorithm" 2> /dev/null \
      || ewarn "Invalid compression algorithm chosen, using default. This kernel may not support this algorithm."; }
    echo "$_mem_to_alloc" > "/sys/block/${_zram}/disksize" 2> /dev/null
  fi

  [ -n "$zram_algo_params" ] \
    && { echo "algo=${zram_comp_algo} ${zram_algo_params}" > "/sys/block/${_zram}/algorithm_params" 2> /dev/null \
    || ewarn "Invalid compression algorithm parameters"; }
  
  [ -n "$zram_mem_limit" ] \
    && { echo "$zram_mem_limit" > "/sys/block/${_zram}/mem_limit" 2> /dev/null \
    || ewarn "Invalid value for memory limit, using default"; }

  [ -n "$zram_idle" ] \
    && { echo "$zram_idle" > "/sys/block/${_zram}/idle" 2> /dev/null \
    || ewarn "Invalid value for idle, using default"; }

  service_set_value zram "${_zram}:${zram_type}"

  case "$zram_type" in
    swap) 
      _mkswap "/dev/${_zram%%:*}"
      ;;
    ext4)
      _mkstorage "/dev/${_zram%%:*}"
      ;;
    *) 
      eerror "Invalid zram type"
      ;;
  esac
  _exit $? "Failed to create zram: ${zram_label}"
}

stop() {
  einfo "Removing zram: ${zram_label}"
  _zram="$(service_get_value zram)"
  case ${_zram##*:} in
    swap)
      _rmswap "/dev/${_zram%%:*}"
      ;;
    ext4)
      _rmstorage "/dev/${_zram%%:*}"
      ;;
  esac
  _exit $? "Failed to remove zram: ${zram_label}"
}

stop_post() {
  [ "$RC_CMD" = "restart" ] && return 0
  if [ -d "/sys/module/zram" ]; then
    _refcnt=0
    _timeout 5 read -r _refcnt < /sys/module/zram/refcnt
    if [ "$_refcnt" -eq 0 ] && _checklocks; then
      ! modprobe -r --dry-run zram > /dev/null 2>&1 \
      || { modprobe -r zram > /dev/null 2>&1 \
          && einfo "Zram module unloaded"; }
    fi
  fi
  eend $? "Failed to remove zram module"
}

# zram doc: https://docs.kernel.org/admin-guide/blockdev/zram.html

# shellcheck shell=sh

# shellcheck disable=SC2034
description="Manages zram devices"

zram_label="${RC_SVCNAME#*.}"

: "${zram_type:=swap}"
: "${zram_size:=50%}"
: "${zram_mem_limit:=}"
: "${zram_backing_dev:=}"
: "${zram_writeback_limit:=}"
: "${zram_writeback_batch_size:=}"
: "${zram_compressed_writeback:=}"
: "${zram_comp_algo:=}"
: "${zram_algo_params:=}"

: "${zram_swap_discard:=}"
: "${zram_swap_priority:=}"

: "${zram_storage_mountpoint:=}"
: "${zram_storage_mode:=}"
: "${zram_storage_options:=}"
: "${zram_storage_owgr:=}"

depend() {
  need localmount
  case $zram_type in
    swap)
      want swap
      ;;
    ext4)
      before bootmisc tmpfiles-setup tmpfiles.setup
      ;;
  esac
  after modules zram.*
}

_isnum() {
  case $1 in
    *[!0-9]*) return 1;;
  esac
  return 0
}

_timeout() {
  _t="$(($1 * 10))" _i=0 
  shift
  while [ "$_i" -lt "$_t" ]; do
    "$@" 2> /dev/null && return 0
    _i="$((_i + 1))"
    sleep 0.1
  done
  return 1
}

_checklocks() {
  set -- /var/lock/zram.*.lock
  [ -e "$1" ] && return 1
  return 0
}

_rmlock() {
  [ -e "/var/lock/zram.${zram_label}.lock" ] \
    && rm "/var/lock/zram.${zram_label}.lock"
}

_mkswap() {
  _zram="$1"
  _sop=""
  if ! [ -n "$zram_swap_priority" ] && ! _isnum "$zram_swap_priority" || { [ "$zram_swap_priority" -gt 32767 ] || [ "$zram_swap_priority" -lt -1 ]; }; then
    ewarn "Invalid swap priority, using default."
    unset zram_swap_priority
  fi
  _sop="-p ${zram_swap_priority:=32767}"
  case "$zram_swap_discard" in
    once|pages) _sop="${_sop} -d${zram_swap_discard}";;
    none|[Nn]|[Nn][Oo]);;
    both|*) _sop="${_sop} -d";;
  esac
  eval "set -- _ $_sop"
  shift
  if mkswap -L "$zram_label" -- "/dev/${_zram}" > /dev/null 2>&1; then
    if swapon "$@" -- "/dev/${_zram}" > /dev/null 2>&1; then
      einfo "Successfully created zram swap: ${zram_label}"
    else
      eerror "Failed to enable zram swap: ${zram_label}"
    fi
  else
    eerror "Failed to create zram swap: ${zram_label}"
  fi
}

_rmswap() {
  _zram="$1"
  for _swap in $(swapon --show=name --raw --noheadings); do
    if [ "/dev/${_zram}" = "$_swap" ]; then
      swapoff -- "/dev/${_zram}" > /dev/null 2>&1
      break
    fi
  done
  _timeout 5 echo 1 > "/sys/block/${_zram}/reset" \
    && _timeout 5 echo "${_zram##*zram}" > /sys/class/zram-control/hot_remove \
    && einfo "Removed zram swap: ${zram_label}"
}

_mkstorage() {
  _zram="$1"
  _fsop="huge_file,sparse_super,extent,^uninit_bg,dir_nlink,extra_isize,^has_journal"
  _mop="defaults"
  _mop="${_mop},${zram_storage_options:=noatime}"
  if ! awk -v uwgr="$zram_storage_owgr" 'BEGIN {if (uwgr ~ /(^[a-z_][a-z0-9_-]*)$|(^[a-z_][a-z0-9_-]*:[a-z_][a-z0-9_-]*)$/) {exit 0} else {exit 1}}'; then
    ewarn "Ivalid value owner:group, using default"
    unset zram_storage_owgr
  fi
  if ! awk -v mode="$zram_storage_mode" 'BEGIN {if (mode ~ /^[0-1]?[0-7]{3}$/) {exit 0} else {exit 1}}'; then
    ewarn "Ivalid value for mode, using default"
    unset zram_storage_mode
  fi
  if mkfs.ext4 -m0 -O"${_fsop}" -L "$zram_label" -- "/dev/${_zram}" > /dev/null 2>&1 \
    && tune2fs -c0 -i0 -- "/dev/${_zram}" > /dev/null 2>&1; then
    if [ -n "$zram_storage_mountpoint" ] \
      && mkdir -p -- "$zram_storage_mountpoint" > /dev/null 2>&1 \
      && mount -t ext4 -o "$_mop" -- "/dev/${_zram}" "$zram_storage_mountpoint" \
      && chmod "${zram_storage_mode:=0775}" -- "$zram_storage_mountpoint" \
      && chown "${zram_storage_owgr:=root:root}" -- "$zram_storage_mountpoint"; then
      einfo "Successfully created zram storage: ${zram_label}"
    else
      eerror "Failed to mount zram storage: ${zram_label}"   
    fi
  else
    eerror "Failed to make zram storage: ${zram_label}"
  fi
}

_rmstorage() {
  _zram="$1"
  while read -r _dev _; do
    if [ "/dev/${_zram}" = "$_dev" ]; then
      umount -- "/dev/${_zram}" > /dev/null 2>&1
      break
    fi
  done < /proc/mounts
  _timeout 5 echo 1 > "/sys/block/${_zram}/reset" \
    && _timeout 5 echo "${_zram##*zram}" > /sys/class/zram-control/hot_remove \
    && einfo "Removed zram storage: ${zram_label}"
}

start_pre() {
  if [ "$zram_label" = "$RC_SVCNAME" ]; then
    eerror "${RC_SVCNAME} cannot be started directly. You must create" 
    eerror "symbolic links to it for the zram devices you want to start"
    return 1
  fi
  if [ "$RC_CMD" = "start" ] && [ -e "/var/lock/zram.${zram_label}.lock" ]; then
    eerror "Zram device with label ${zram_label} already exists"
    return 1
  fi
  if ! [ -d "/sys/module/zram" ]; then
    ebegin "Starting zram"
    ! modprobe --dry-run zram > /dev/null 2>&1 \
    || { modprobe zram > /dev/null 2>&1 \
        && einfo "Zram module loaded"; }
  fi
  eend $? "Could not find or load zram module"
}

start() {
  _zram=""
  _mem_size=""
  _mem_limit=""
  _hot=0
  _refcnt=0
  _mem_total=0
  _state=0

  for _zram_dev in /sys/block/zram*; do
    _timeout 5 read -r _state < "${_zram_dev}/initstate"
    if [ "$_state" -eq 0 ]; then
      _zram="${_zram_dev##*/}"
      break
    fi
  done
  if [ -z "$_zram" ]; then
    if _timeout 5 read -r _hot < /sys/class/zram-control/hot_add; then
        _zram="zram${_hot}"
    else
      eerror "Failed to hot add a zram device"
      return 1
    fi
  fi

  if ! [ -e  "/var/lock/zram.${zram_label}.lock" ] && ! touch "/var/lock/zram.${zram_label}.lock"; then
    eerror "A lock file exists"
    return 1
  fi

  while read -r _mem_header _mem_size _; do [ "$_mem_header" != "MemTotal:" ] || break; done < /proc/meminfo
  _mem_total="$((_mem_size / 1024))"

  case "${zram_size##*[0-9]}" in
    %)
      _mem_size="$((${zram_size%\%} * _mem_total / 100))MiB"
      ;;
    [KkMmGgTtPpEeZzYy]|[KkMmGgTtPpEeZzYy][Ii][Bb])
      _mem_size="$zram_size"
      ;;
    *)
      ewarn "Invalid value for size, using default"
      _mem_size="$((50 * _mem_total / 100))MiB"
      ;;
  esac

  if [ -n "$zram_mem_limit" ]; then
    case "${zram_mem_limit##*[0-9]}" in
      %)
        _mem_limit="$((${zram_mem_limit%\%} * _mem_total / 100))MiB"
        ;;
      [KkMmGgTtPpEeZzYy]|[KkMmGgTtPpEeZzYy][Ii][Bb])
        _mem_limit="$zram_mem_limit"
        ;;
      *)
        ewarn "Invalid value for memory limit"
        ;;
    esac
  fi

  einfo "Initializing zram device: /dev/${_zram}"
  
  if ! _timeout 5 echo 1 > "/sys/block/${_zram}/reset"; then
    eerror "Failed to reset zram device /dev/${_zram}: device or resource busy"
    _rmlock
    return 1
  fi

  if [ -n "$zram_backing_dev" ]; then
    if echo "$zram_backing_dev" > "/sys/block/${_zram}/backing_dev" 2> /dev/null; then
      if [ -n "$zram_comp_algo" ] && echo "$zram_comp_algo" > "/sys/block/${_zram}/comp_algorithm" 2> /dev/null; then
        [ -n "$zram_algo_params" ] \
          && { echo "algo=${zram_comp_algo} ${zram_algo_params}" > "/sys/block/${_zram}/algorithm_params" 2> /dev/null \
          || ewarn "Invalid compression algorithm parameters"; }
      else
        ewarn "Invalid compression algorithm chosen, using default. This kernel may not support this algorithm."
      fi
      case $zram_compressed_writeback in
          [Yy]|[Yy][Ee][Ss]) echo 1 > "/sys/block/${_zram}/compressed_writeback" 2> /dev/null || ewarn "Failed to enable /dev/${_zram} compressed writeback";;
          [Nn]|[Nn][Oo]|*) echo 0 > "/sys/block/${_zram}/compressed_writeback" 2> /dev/null || ewarn "Failed to enable /dev/${_zram} compressed writeback";;
      esac
      echo "$_mem_size" > "/sys/block/${_zram}/disksize" 2> /dev/null
      if [ -n "$zram_writeback_limit" ] && ! echo "$((${zram_writeback_limit%%[A-Za-z]*}<<20>>12))" > "/sys/block/${_zram}/writeback_limit" 2> /dev/null \
        || ! echo 1 > "/sys/block/${_zram}/writeback_limit_enable" 2> /dev/null; then
        ewarn "Failed to write /dev/${_zram} writeback limit"
      fi
      if [ -n "${zram_writeback_batch_size}" ] && ! echo "$zram_writeback_batch_size" > "/sys/block/${_zram}/writeback_batch_size" 2> /dev/null; then
        ewarn "Failed to write /dev/${_zram} writeback batch size"
      fi
    else
      eerror "Failed to write /dev/${_zram} backing device"
      _rmlock
      return 1
    fi
  else
    if [ -n "$zram_comp_algo" ] && echo "$zram_comp_algo" > "/sys/block/${_zram}/comp_algorithm" 2> /dev/null; then
      [ -n "$zram_algo_params" ] \
        && { echo "algo=${zram_comp_algo} ${zram_algo_params}" > "/sys/block/${_zram}/algorithm_params" 2> /dev/null \
        || ewarn "Invalid compression algorithm parameters"; }
    else
      ewarn "Invalid compression algorithm chosen, using default. This kernel may not support this algorithm."
    fi
    if ! echo "$_mem_size" > "/sys/block/${_zram}/disksize" 2> /dev/null; then
      eerror "Failed to write /dev/${_zram} size"
      _rmlock
      return 1
    fi
  fi
  
  if [ -n "$_mem_limit" ] && ! echo "$zram_mem_limit" > "/sys/block/${_zram}/mem_limit" 2> /dev/null; then
    eerror "Failed to write /dev/${_zram} memory limit"
    _rmlock
    return 1
  fi
  
  case "$zram_type" in
    swap)
      service_set_value zram "${_zram}:${zram_type}"
      _mkswap "$_zram" \
        || ! _rmlock
      ;;
    ext4)
      service_set_value zram "${_zram}:${zram_type}"
      _mkstorage "$_zram" \
        || ! _rmlock
      ;;
    *) 
      _rmlock
      eerror "Invalid zram type"
      ;;
  esac
  eend "$?" "Failed to create zram: ${zram_label}"
}

stop() {
  yesno "$RC_GOINGDOWN" && return 0
  einfo "Removing zram: ${zram_label}"
  _zram="$(service_get_value zram)"
  case ${_zram##*:} in
    swap)
      _rmswap "${_zram%%:*}" \
        && _rmlock
      ;;
    ext4)
      _rmstorage "${_zram%%:*}" \
        && _rmlock
      ;;
  esac
  eend $? "Failed to remove zram: ${zram_label}"
}

stop_post() {
  { [ "$RC_CMD" = "restart" ] || yesno "$RC_GOINGDOWN"; } && return 0
  if [ -d "/sys/module/zram" ] && _checklocks; then
    _refcnt=0
    _timeout 5 read -r _refcnt < /sys/module/zram/refcnt
    if [ "$_refcnt" -eq 0 ]; then
      ! modprobe -r --dry-run -- zram > /dev/null 2>&1 \
      || { modprobe -r -- zram > /dev/null 2>&1 \
          && einfo "Zram module unloaded"; }
    fi
  fi
  eend $? "Failed to remove zram module"
}

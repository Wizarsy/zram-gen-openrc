#!/sbin/openrc-run

description="Manages zram swap devices"

depend() {
  need localmount swap
}

_timeout() {
  local t=$(($1 * 10)) i=0 
  shift
  while [ "$i" -lt "$t" ]; do
    "$@" 2> /dev/null && return 0
    i=$((i + 1))
    sleep 0.1
  done
  ewarn "Timeout reached, device or resource busy."
  return 1
}

start_pre() {
  ebegin "Starting zram-gen"
  einfo "Checking the status of the zram module"
  if ! [ -d "/sys/module/zram" ]; then
    if modprobe --dry-run zram &> /dev/null; then
      modprobe zram &> /dev/null \
        && einfo "Zram module loaded"
      sleep 0.1
    fi
  else
    einfo "Zram module already loaded"
  fi
  [ $? -eq 0 ] && mkdir -p /var/run/zram-gen &> /dev/null
  eend "$?" "Could not find or load zram module"
}

start() {
  local size="" comp_algo="" algo_params="" \
    mem_limit="" priority="" discard_opt="" backing_dev="" \
    swapon_discard_opt="" mem_to_alloc="" swap_devs="" i=0

  read -r supported_algo < /sys/block/zram0/comp_algorithm

  while read -r mem_header mem_size _; do [ "$mem_header" != "MemTotal:" ] || break; done < /proc/meminfo
  mem_total=$((mem_size / 1024))

  while read -r dev _; do [ "$dev" != "Filename" ] && swap_devs="$swap_devs $dev"; done < /proc/swaps

  einfo "Total host memory: ${mem_total}MiB"

  while eval "[ \${ZRAM${i}:-false} == 'true' ]"; do
    eval "size=\${ZRAM${i}_SIZE:-25%}"
    eval "discard_opt=\${ZRAM${i}_DISCARD_OPT:-both}"
    eval "priority=\${ZRAM${i}_PRIORITY:-32767}"
    eval "mem_limit=\$ZRAM${i}_MEM_LIMIT"
    eval "comp_algo=\$ZRAM${i}_COMP_ALGO"
    eval "algo_params=\$ZRAM${i}_ALGO_PARAMS"
    eval "backing_dev=\$ZRAM${i}_BACKING_DEV"
    eval "writeback=\${ZRAM${i}_WRITEBACK:-idle}"

    for dev in $swap_devs; do
      [ "$dev" = "/dev/zram${i}" ] \
        && einfo "/dev/zram${i} is already mounted as a swap device" \
        && ln --symbolic --force "/dev/zram${i}" "/var/run/zram-gen/zram${i}" &> /dev/null \
        && i=$((i + 1)) \
        && continue 2
    done

    [ -b "/dev/zram${i}" ] \
      || _timeout 10 read -r _ < /sys/class/zram-control/hot_add \
      || { eerror "Failed to hot add a zram device" \
      && break ; }

    einfo "Initializing zram device: /dev/zram${i}"
    
    _timeout 10 echo 1 > "/sys/block/zram${i}/reset" \
      || { ewarn "Failed to reset zram device, device or resource busy" \
      && i=$((i + 1)) \
      && continue ; }

    [ -n "$backing_dev" ] \
      && { echo "$backing_dev" > "/sys/block/zram${i}/backing_dev" 2> /dev/null \
      || ewarn "Failed to write zram${i} backing device" ; }

    [ -n "$comp_algo" ] \
      && { echo "$comp_algo" > "/sys/block/zram${i}/comp_algorithm" 2> /dev/null \
      || ewarn "Invalid compression algorithm chosen, using default. This kernel only support: [ ${supported_algo} ]" ; }
    
    [ -n "$algo_params" ] \
      && { echo "algo=${comp_algo%%:*} ${algo_params}" > "/sys/block/zram${i}/algorithm_params" 2> /dev/null \
      || ewarn "Invalid compression algorithm parameters" ; }

    case "${size##*[0-9]}" in
      %)
        mem_to_alloc="$((${size%\%} * mem_total / 100))"
        ;;
      [KkMmGgTtPpEeZzYy]|[KkMmGgTtPpEeZzYy][Ii][Bb])
        mem_to_alloc=$size
        ;;
      *)
        ewarn "Invalid value for size, using default"
        mem_to_alloc="$((25 * mem_total / 100))"
        ;;
    esac

    echo "${mem_to_alloc}MiB" > "/sys/block/zram${i}/disksize" 2> /dev/null

    [ -n "$mem_limit" ] \
      && { echo "$mem_limit" > "/sys/block/zram${i}/mem_limit" 2> /dev/null \
      || ewarn "Invalid value for memory limit, using default" ; }

    [ -n "$backing_dev" -a -n "$writeback" ] \
      && { echo "$writeback" > "/sys/block/zram${i}/writeback" 2> /dev/null \
      || ewarn "Failed to set zram${i} writeback" ; }

    case "$discard_opt" in
      both)
        swapon_discard_opt="--discard"
        ;;
      once|pages)
        swapon_discard_opt="--discard=${discard_opt}"
        ;;
      *)
        ewarn "Invalid value for discard, using default"
        swapon_discard_opt="--discard"
        ;;
    esac
    
    [ "$priority" -gt 32767 ] \
      && ewarn "Invalid swap priority, using default." \
      && priority=32767
    
    { mkswap --uuid clear --label "ZRAM${i}" "/dev/zram${i}" &> /dev/null \
      && swapon "$swapon_discard_opt" --priority "$priority" "/dev/zram${i}" &> /dev/null \
      && ln --symbolic --force "/dev/zram${i}" "/var/run/zram-gen/zram${i}" &> /dev/null \
      && einfo "Successfully created zram swap device: /dev/zram${i}" ; } \
      || eerror "Failed to initialize zram swap device: /dev/zram${i}"

    i=$((i + 1))
  done
  eend "$?" "Failed to create zram swap device(s)"
}

stop() {
  for device in /var/run/zram-gen/*; do
    ! [ -b "$device" ] && continue
    dev_name="${device##*\/}"
    einfo "Removing zram device: /dev/${dev_name}"
    swapoff "/dev/${dev_name}" \
      && _timeout 10 echo 1 > "/sys/block/zram${i}/reset" \
      && rm -f "/var/run/zram-gen/${dev_name}" &> /dev/null \
      && einfo "Removed zram device: /dev/${dev_name}"
  done
 eend $? "Failed to remove zram device(s)"
}

stop_post() {
  if [ -d "/sys/module/zram" ]; then
    _timeout 10 read -r refcnt < /sys/module/zram/refcnt
    if [ $? -eq 0 -a "$RC_CMD" != "restart" -a "$refcnt" -eq 0 ]; then
      modprobe -r zram &> /dev/null \
        && einfo "Zram module unloaded"
      [ $? -eq 0 -a -d "/var/run/zram-gen" ] && rm -rf /var/run/zram-gen
    fi
  fi
  eend $? "Failed to remove zram module"
}
